# Create React App: ONLY `REACT_APP_*` is embedded in the client bundle (`npm start` / `npm run build`).
# Netlify: Site settings → Environment variables → add these → redeploy.
#
# Copy to `.env.local` for local dev (optional — defaults are also set in src/config/defaultSupabasePublic.js).

REACT_APP_SUPABASE_URL=https://llpjrzerpnptbfeoqgrk.supabase.co
# Publishable key OR legacy anon JWT (both work with supabase-js for table REST calls):
REACT_APP_SUPABASE_PUBLISHABLE_KEY=sb_publishable_2oKaCUwFRYW1NCmO6sfjPQ_XukDJJPC
# REACT_APP_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Netlify: prefer REACT_APP_* above. `NEXT_PUBLIC_*` is NOT injected by CRA unless you customize webpack.

# Use the old localStorage-only admin (no API): set to "true" and do not set Supabase credentials
# REACT_APP_DISABLE_SUPABASE=true

# If you use Next.js or another tool that only defines these, the client will still pick them up
# in compatible setups:
# NEXT_PUBLIC_SUPABASE_URL=
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Default test staff sign-in (optional overrides)
# REACT_APP_TEST_ADMIN_EMAIL=staff.test@dpc.local
# If the password contains #, quote it: REACT_APP_TEST_ADMIN_PASSWORD="DpcTest#2026!"

# Hide the test credential hints on the login page
# REACT_APP_SHOW_TEST_AUTH_HINT=false

# Legacy: local mode only (when not using Supabase)
# REACT_APP_SHOW_ADMIN_HINT=false
