generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SECRETARY
  ADMIN
  CLINICIAN
}

enum RequestStatus {
  SUBMITTED
  UNDER_REVIEW
  AWAITING_MORE_INFORMATION
  AWAITING_CALL_BACK
  APPOINTMENT_PROPOSED
  PAYMENT_PENDING
  CONFIRMED
  DECLINED
  REFERRED_ELSEWHERE
  CANCELLED
}

enum RequestCategory {
  NEW_ENQUIRY
  FOLLOW_UP
  URGENT
  ROUTINE
  NOT_SUITABLE
}

enum RequestActionType {
  ASK_FOR_MORE_INFORMATION
  CALL_PATIENT
  BOOK_APPOINTMENT
  DECLINE_OR_REFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum PaymentProvider {
  STRIPE
}

model User {
  id           String   @id @default(cuid())
  supabaseUserId String? @unique
  email        String   @unique
  passwordHash String?
  firstName    String?
  lastName     String?
  role         UserRole @default(SECRETARY)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  notes         RequestNote[]
  statusHistory RequestStatusHistory[]
  actions       RequestAction[]
  auditLogs     AuditLog[]
}

model BookingRequest {
  id                String          @id @default(cuid())
  publicId          String          @unique
  title             String?
  firstName         String
  surname           String
  dateOfBirth       DateTime?
  gender            String?
  email             String
  mobile            String
  addressLookup     String?
  gpPractice        String?
  noGp              Boolean         @default(false)
  reason            String
  preferredDate     DateTime?
  preferredTimeText String?
  reservedSlotId    String?
  consent           Boolean         @default(false)
  status            RequestStatus   @default(SUBMITTED)
  category          RequestCategory @default(NEW_ENQUIRY)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  notes         RequestNote[]
  statusHistory RequestStatusHistory[]
  actions       RequestAction[]
  appointments  Appointment[]
  payments      Payment[]
  auditLogs     AuditLog[]
  reservedSlot  AvailabilitySlot? @relation("BookingRequestReservedSlot", fields: [reservedSlotId], references: [id], onDelete: SetNull)

  @@index([status, category, createdAt])
}

model RequestNote {
  id        String         @id @default(cuid())
  requestId String
  authorId  String?
  body      String
  createdAt DateTime       @default(now())

  request BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  author  User?          @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model RequestStatusHistory {
  id          String        @id @default(cuid())
  requestId   String
  fromStatus  RequestStatus?
  toStatus    RequestStatus
  changedById String?
  reason      String?
  createdAt   DateTime      @default(now())

  request   BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  changedBy User?          @relation(fields: [changedById], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model RequestAction {
  id         String            @id @default(cuid())
  requestId  String
  actionType RequestActionType
  actorId    String?
  notes      String?
  createdAt  DateTime          @default(now())

  request BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  actor   User?          @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([requestId, createdAt])
}

model AvailabilityDay {
  id        String   @id @default(cuid())
  date      DateTime @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  slots AvailabilitySlot[]
}

model AvailabilitySlot {
  id               String          @id @default(cuid())
  dayId            String
  time             String
  capacity         Int             @default(1)
  enabled          Boolean         @default(true)
  reservedCount    Int             @default(0)
  appointmentCount Int             @default(0)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  day          AvailabilityDay @relation(fields: [dayId], references: [id], onDelete: Cascade)
  appointments Appointment[]
  reservedRequests BookingRequest[] @relation("BookingRequestReservedSlot")

  @@unique([dayId, time])
}

model Appointment {
  id          String   @id @default(cuid())
  requestId   String
  slotId      String?
  appointmentAt DateTime
  location    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  request BookingRequest    @relation(fields: [requestId], references: [id], onDelete: Cascade)
  slot    AvailabilitySlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)

  @@index([requestId])
}

model Payment {
  id                  String          @id @default(cuid())
  requestId           String
  provider            PaymentProvider @default(STRIPE)
  status              PaymentStatus   @default(PENDING)
  amountMinor         Int
  currency            String          @default("gbp")
  paymentLinkUrl      String?
  checkoutSessionId   String?
  providerPaymentId   String?
  providerEventId     String?
  paidAt              DateTime?
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  request BookingRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, status])
  @@index([providerEventId])
}

model AuditLog {
  id         String   @id @default(cuid())
  actorId    String?
  requestId  String?
  entityType String
  entityId   String
  action     String
  metadata   Json?
  createdAt  DateTime @default(now())

  actor   User?           @relation(fields: [actorId], references: [id], onDelete: SetNull)
  request BookingRequest? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([requestId, createdAt])
}
